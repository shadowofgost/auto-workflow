# Image reference: Docker Hub, GHCR, a date tag, or a local image.
NEVERIDLE_IMAGE=shadowofgost/neveridle:latest

# CPU mode: c = interval (e.g. 2h); cp = fraction (e.g. 0.15).
# Change MODE and VALUE together. VALUE=0 disables CPU load.
NEVERIDLE_CPU_MODE=c
NEVERIDLE_CPU_VALUE=2h

# Memory in whole GiB. 0 disables memory allocation.
NEVERIDLE_MEMORY_GIB=2

# Speed test interval, e.g. 4h or 12h30m. 0 disables speed tests.
NEVERIDLE_NETWORK_INTERVAL=4h

# Positive integer; only used when speed tests are enabled.
NEVERIDLE_NETWORK_CONNECTIONS=10
